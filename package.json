{
  "name": "weixin-codex-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "Bridge Weixin iLink messages to persisted Codex Desktop threads.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "weixin-codex": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/cli.js run",
    "setup": "node dist/cli.js setup",
    "doctor": "node dist/cli.js doctor",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@openai/codex": "0.146.0-alpha.3.1",
    "@roamhq/wrtc": "^0.10.0",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "0.12.0",
    "silk-wasm": "3.7.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "typescript": "^5.8.0",
    "vitest": "^3.1.0"
  }
}
