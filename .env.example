# Optional data and local transcription paths
WEIXIN_CODEX_DATA_DIR=
WEIXIN_CODEX_WHISPER_MODEL=

# GPT-Live
WEIXIN_CODEX_REALTIME_MODEL=gpt-live-1-codex
WEIXIN_CODEX_REALTIME_VOICE=sol
WEIXIN_CODEX_REALTIME_IDLE_MS=300000
WEIXIN_CODEX_REALTIME_OUTPUT_TIMEOUT_MS=30000
WEIXIN_CODEX_AUDIO_FILENAME=GPT-Live语音.wav

# Security (semicolon-separated Windows paths)
WEIXIN_CODEX_ALLOWED_ROOTS=
WEIXIN_CODEX_SAFE_MODE=0
